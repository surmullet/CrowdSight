{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdsight.invalid/contracts/v1/crowd-frame-observation.schema.json",
  "title": "CrowdSight Crowd Frame Observation v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "session_id",
    "model_profile_id",
    "model_profile_sha256",
    "checkpoint_sha256",
    "tracker_config_sha256",
    "frame_index",
    "media_time_s",
    "captured_at",
    "image_width",
    "image_height",
    "observation_valid",
    "registration_valid",
    "fully_observed_zones",
    "confidence_semantics",
    "quality",
    "detections"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "model_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "model_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "checkpoint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tracker_config_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0
    },
    "media_time_s": {
      "type": "number",
      "minimum": 0
    },
    "captured_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "image_width": {
      "type": "integer",
      "minimum": 1
    },
    "image_height": {
      "type": "integer",
      "minimum": 1
    },
    "observation_valid": {
      "type": "boolean"
    },
    "registration_valid": {
      "type": "boolean"
    },
    "fully_observed_zones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Zone IDs with complete observable coverage in this frame. Omitted configured zones remain unavailable, especially for PARTIAL observations."
    },
    "confidence_semantics": {
      "const": "RAW_MODEL_SCORE"
    },
    "quality": {
      "enum": [
        "VALID",
        "PARTIAL",
        "UNKNOWN",
        "STALE"
      ]
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track_id",
          "x",
          "y",
          "confidence",
          "bbox_xyxy"
        ],
        "properties": {
          "track_id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Uncalibrated model score; not a correctness probability."
          },
          "bbox_xyxy": {
            "oneOf": [
              {
                "$ref": "#/$defs/bbox_xyxy"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required nullable source-frame pixel box [x1, y1, x2, y2], with x2/y2 exclusive. Use null when the inference adapter does not expose boxes."
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "bbox_xyxy": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "quality": {
            "enum": [
              "VALID",
              "PARTIAL"
            ]
          }
        },
        "required": [
          "quality"
        ]
      },
      "then": {
        "properties": {
          "observation_valid": {
            "const": true
          },
          "fully_observed_zones": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quality": {
            "const": "PARTIAL"
          }
        },
        "required": [
          "quality"
        ]
      },
      "then": {
        "properties": {
          "fully_observed_zones": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quality": {
            "enum": [
              "UNKNOWN",
              "STALE"
            ]
          }
        },
        "required": [
          "quality"
        ]
      },
      "then": {
        "properties": {
          "observation_valid": {
            "const": false
          },
          "fully_observed_zones": {
            "maxItems": 0
          },
          "detections": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detections": {
            "contains": {
              "type": "object",
              "properties": {
                "track_id": {
                  "type": "integer"
                }
              },
              "required": [
                "track_id"
              ]
            }
          }
        },
        "required": [
          "detections"
        ]
      },
      "then": {
        "properties": {
          "tracker_config_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ]
}
